# Copy this file to .env.production.local in the frontend project root.
# Replace the placeholder with the deployed Django backend origin.
# The value must include /api and must not end with a slash.
VITE_CSRMS_API_BASE_URL=https://YOUR-DJANGO-DOMAIN.example.com/api
VITE_CSRMS_TELEMETRY_HISTORY_PATH=/telemetry/history/

# Never place Django secrets, JWT secrets, or IoT device keys in VITE_ variables.
