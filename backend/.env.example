# Copy to backend/.env on the deployment platform and replace every placeholder.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=YOUR-DJANGO-DOMAIN.example.com
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN.example.com

# Keep device keys out of source control. Provision them with:
# python manage.py provision_device <device-id> <network|water|fire> --location "<location>"
